{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/experience-strategy.schema.json",
  "type": "object",
  "required": ["schemaVersion", "sourceBindings", "scene", "primaryUsers", "userGoals", "informationArchitecture", "dataExpression", "functionalPlan", "visualDirection", "designSystem", "responsive", "accessibility", "motion", "antiPatterns"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "sourceBindings": { "type": "object", "required": ["codeReferenceHash", "pageSkeletonHash", "displayEvidenceHash"], "properties": { "codeReferenceHash": { "type": "string", "minLength": 1 }, "pageSkeletonHash": { "type": "string", "minLength": 1 }, "displayEvidenceHash": { "type": "string", "minLength": 1 } } },
    "scene": { "type": "string", "minLength": 1 }, "primaryUsers": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "userGoals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "informationArchitecture": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["priority", "purpose", "content"], "properties": { "priority": { "type": "integer" }, "purpose": { "type": "string" }, "content": { "type": "array" } } } },
    "dataExpression": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["question", "metric", "comparison", "encoding", "interaction", "rationale"], "properties": { "question": { "type": "string", "minLength": 1 }, "metric": { "type": "string", "minLength": 1 }, "comparison": { "type": "string", "minLength": 1 }, "encoding": { "type": "string", "minLength": 1 }, "interaction": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 } } } },
    "functionalPlan": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["task", "component", "states", "events", "acceptance"], "properties": { "task": { "type": "string", "minLength": 1 }, "component": { "type": "string", "minLength": 1 }, "states": { "type": "array", "minItems": 1 }, "events": { "type": "array", "minItems": 1 }, "acceptance": { "type": "array", "minItems": 1 } } } },
    "visualDirection": { "type": "object", "required": ["hierarchy", "density", "composition", "colorSemantics", "typography"], "properties": { "hierarchy": { "type": "string", "minLength": 1 }, "density": { "type": "string", "minLength": 1 }, "composition": { "type": "string", "minLength": 1 }, "colorSemantics": { "type": "string", "minLength": 1 }, "typography": { "type": "string", "minLength": 1 } } }, "designSystem": { "type": "object", "required": ["tokens", "components", "styleBaseline"], "properties": { "tokens": { "type": "array", "minItems": 1 }, "components": { "type": "array", "minItems": 1 }, "styleBaseline": { "type": "object", "required": ["mode", "typography", "colors", "spacing", "geometry"], "properties": { "mode": { "enum": ["existing-platform", "greenfield-standard"] }, "sourceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "typography": { "type": "object" }, "colors": { "type": "object" }, "spacing": { "type": "object" }, "geometry": { "type": "object" } } } } }, "responsive": { "type": "object", "required": ["breakpoints", "reflowRules"], "properties": { "breakpoints": { "type": "array", "minItems": 1 }, "reflowRules": { "type": "array", "minItems": 1 } } }, "accessibility": { "type": "object", "required": ["target", "keyboard", "semantics"], "properties": { "target": { "type": "string", "minLength": 1 }, "keyboard": { "type": "array", "minItems": 1 }, "semantics": { "type": "array", "minItems": 1 } } }, "motion": { "type": "object", "required": ["purpose", "bindings", "reducedMotion"], "properties": { "purpose": { "type": "array", "minItems": 1 }, "bindings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["task", "event", "stateTransition", "informationBenefit", "valueStatement"], "properties": { "task": { "type": "string", "minLength": 1 }, "event": { "type": "string", "minLength": 1 }, "stateTransition": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 } } }, "informationBenefit": { "enum": ["operation-feedback", "state-change", "spatial-orientation", "hierarchy-guidance", "progress-explanation", "risk-notice"] }, "valueStatement": { "type": "string", "minLength": 12 } } } }, "reducedMotion": { "type": "string", "minLength": 1 } } }, "antiPatterns": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
  }
}
