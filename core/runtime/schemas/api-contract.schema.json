{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/api-contract.schema.json",
  "type": "object",
  "required": ["schemaVersion", "version", "endpoints", "errors", "authentication"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "version": { "type": "string", "minLength": 1 },
    "endpoints": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["method", "path", "requestSchema", "responseSchema"], "properties": { "method": { "type": "string" }, "path": { "type": "string" }, "requestSchema": { "type": "string" }, "responseSchema": { "type": "string" } } } },
    "errors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "authentication": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
