{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/dependency-lock.schema.json",
  "type": "object",
  "required": ["schemaVersion", "resolvedAt", "items"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "resolvedAt": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetRef", "source", "version", "entrypoints", "peers", "sidecars", "runtime", "license", "fallback", "smokeTest"],
        "properties": {
          "assetRef": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "entrypoints": { "type": "array" },
          "peers": { "type": "array" },
          "sidecars": { "type": "array" },
          "runtime": { "type": "object" },
          "license": { "type": "object" },
          "fallback": { "type": "object" },
          "smokeTest": { "enum": ["passed", "not-required"] }
        }
      }
    }
  }
}
