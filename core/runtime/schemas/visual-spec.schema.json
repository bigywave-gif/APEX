{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/visual-spec.schema.json",
  "type": "object",
  "required": ["schemaVersion", "layout", "components", "content", "data", "icons", "tables", "charts", "diagrams", "motion", "interaction", "responsive", "acceptance"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "layout": { "type": "object" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["visualNode", "stitchNode", "screenId", "runtimeTarget", "designTokens", "data", "apiContracts", "events", "permissions", "responsive", "testSelectors", "acceptance"]
      }
    },
    "content": { "type": "object" },
    "data": { "type": "object" },
    "icons": { "type": "array", "items": { "type": "object", "required": ["id", "sourceSelectionId", "api", "runtimeTarget", "selector", "size", "colorToken"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceSelectionId": { "type": "string", "minLength": 1 }, "api": { "type": "string", "minLength": 1 }, "runtimeTarget": { "type": "string", "minLength": 1 }, "selector": { "type": "string", "minLength": 1 }, "size": { "type": ["number", "string"] }, "strokeWidth": { "type": ["number", "string"] }, "colorToken": { "type": "string", "minLength": 1 } } } },
    "tables": { "type": "array" },
    "charts": { "type": "array", "items": { "type": "object", "required": ["id", "sourceSelectionId", "renderer", "api", "runtimeTarget", "selector", "themeSourceId", "themeId", "paletteTokens", "typographyToken", "composition"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceSelectionId": { "type": "string", "minLength": 1 }, "renderer": { "enum": ["canvas", "svg", "webgl", "dom"] }, "api": { "type": "string", "minLength": 1 }, "runtimeTarget": { "type": "string", "minLength": 1 }, "selector": { "type": "string", "minLength": 1 }, "themeSourceId": { "type": "string", "minLength": 1 }, "themeId": { "type": "string", "minLength": 1 }, "paletteTokens": { "type": "array", "minItems": 1 }, "typographyToken": { "type": "string", "minLength": 1 }, "composition": { "type": "object", "minProperties": 1 } } } },
    "diagrams": { "type": "array" },
    "motion": { "type": "array" },
    "interaction": { "type": "array" },
    "responsive": { "type": "object" },
    "acceptance": { "type": "array", "minItems": 1 }
  }
}
