{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/motion-capability-selection.schema.json",
  "type": "object",
  "required": ["schemaVersion", "inventoryHash", "designSkills", "componentSources", "bindings"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "inventoryHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "designSkills": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "componentSources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "bindings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["motionId", "sourceSelectionId", "sourceType", "capabilityId", "engine", "implementationPath", "api", "previewTimestampsMs"],
        "properties": {
          "motionId": { "type": "string", "minLength": 1 },
          "sourceSelectionId": { "type": "string", "minLength": 1 },
          "sourceType": { "enum": ["existing-project", "native-web", "approved-candidate"] },
          "capabilityId": { "type": "string", "minLength": 1 },
          "engine": { "enum": ["css", "waapi", "framer-motion", "gsap"] },
          "implementationPath": { "type": "string", "minLength": 1 },
          "api": { "type": "string", "minLength": 1 },
          "previewTimestampsMs": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 0 } },
          "dependency": {
            "type": "object",
            "required": ["package", "version", "status", "source"],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "status": { "enum": ["installed", "planned", "not-required"] },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
