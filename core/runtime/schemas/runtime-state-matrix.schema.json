{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/runtime-state-matrix.schema.json",
  "type": "object",
  "required": ["schemaVersion", "baseline", "responsiveContractId", "viewports", "rangeChecks", "states", "interactions", "checkedAt", "status"],
  "properties": {
    "schemaVersion": { "const": "3.0" }, "baseline": { "type": "object", "required": ["kind", "imageHash"], "properties": { "kind": { "enum": ["stitch", "effect-image"] }, "imageHash": { "type": "string", "minLength": 1 } } }, "responsiveContractId": { "type": "string", "minLength": 1 }, "stitchImageHash": { "type": "string", "minLength": 1 }, "viewports": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["name", "class", "width", "height", "screenshot", "status"], "properties": { "name": { "type": "string", "minLength": 1 }, "class": { "enum": ["mobile", "tablet", "desktop"] }, "width": { "type": "integer", "minimum": 320 }, "height": { "type": "integer", "minimum": 480 }, "screenshot": { "type": "string", "minLength": 1 }, "status": { "const": "passed" } } } }, "rangeChecks": { "type": "array", "minItems": 9, "items": { "type": "object", "required": ["class", "width", "screenshot", "checks", "result"], "properties": { "class": { "enum": ["mobile", "tablet", "desktop"] }, "width": { "type": "integer", "minimum": 320 }, "screenshot": { "type": "string", "minLength": 1 }, "checks": { "type": "object", "required": ["noHorizontalOverflow", "noOverlap", "noClipping", "textLegible", "proportionsStable"], "properties": { "noHorizontalOverflow": { "const": true }, "noOverlap": { "const": true }, "noClipping": { "const": true }, "textLegible": { "const": true }, "proportionsStable": { "const": true } } }, "result": { "const": "passed" } } } }, "states": { "type": "array", "minItems": 5, "items": { "type": "object", "required": ["name", "applicable", "result"], "properties": { "name": { "enum": ["default", "loading", "empty", "error", "permission-denied"] }, "applicable": { "type": "boolean" }, "result": { "enum": ["passed", "not-applicable"] }, "reason": { "type": "string" }, "screenshot": { "type": "string" } } } }, "interactions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "result", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "result": { "const": "passed" }, "evidence": { "type": "string", "minLength": 1 } } } }, "checkedAt": { "type": "string", "minLength": 1 }, "status": { "const": "passed" }
  }
}
