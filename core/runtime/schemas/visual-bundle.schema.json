{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/visual-bundle.schema.json",
  "type": "object",
  "required": ["schemaVersion", "siteContract", "implementationBaseline", "layout", "components", "content", "data", "assets", "icons", "tables", "charts", "diagrams", "motion", "interaction", "responsive", "visualSourceManifest", "implementationMap", "acceptance"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "scopeControl": { "type": "object" },
    "siteContract": { "type": "object", "required": ["version", "hash"] },
    "stitchFreeze": { "type": "object", "required": ["path", "screenSetHash"] },
    "implementationBaseline": { "type": "object", "required": ["kind", "path", "hash"], "properties": { "kind": { "enum": ["stitch", "effect-image"] }, "path": { "type": "string", "minLength": 1 }, "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } },
    "layout": { "type": "object" },
    "components": { "type": "array" },
    "content": { "type": "object" },
    "data": { "type": "object" },
    "assets": { "type": "array" },
    "icons": { "type": "array", "items": { "type": "object", "required": ["id", "sourceSelectionId", "api", "runtimeTarget", "selector", "size", "colorToken"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceSelectionId": { "type": "string", "minLength": 1 }, "api": { "type": "string", "minLength": 1 }, "runtimeTarget": { "type": "string", "minLength": 1 }, "selector": { "type": "string", "minLength": 1 }, "size": { "type": ["number", "string"] }, "strokeWidth": { "type": ["number", "string"] }, "colorToken": { "type": "string", "minLength": 1 } } } },
    "tables": { "type": "array" },
    "charts": { "type": "array", "items": { "type": "object", "required": ["id", "sourceSelectionId", "renderer", "api", "runtimeTarget", "selector", "themeSourceId", "themeId", "paletteTokens", "typographyToken", "composition", "dataSource", "actual", "target", "anomalies", "forecast", "acceptance"], "properties": { "id": { "type": "string" }, "sourceSelectionId": { "type": "string", "minLength": 1 }, "renderer": { "enum": ["canvas", "svg", "webgl", "dom"] }, "api": { "type": "string", "minLength": 1 }, "runtimeTarget": { "type": "string", "minLength": 1 }, "selector": { "type": "string", "minLength": 1 }, "themeSourceId": { "type": "string", "minLength": 1 }, "themeId": { "type": "string", "minLength": 1 }, "paletteTokens": { "type": "array", "minItems": 1 }, "typographyToken": { "type": "string", "minLength": 1 }, "composition": { "type": "object", "minProperties": 1 }, "dataSource": { "type": "string" }, "actual": { "type": "object" }, "target": { "type": "object" }, "anomalies": { "type": "array" }, "forecast": { "type": "object" }, "acceptance": { "type": "array", "minItems": 1 } } } },
    "diagrams": { "type": "array" },
    "motion": { "type": "array", "items": { "type": "object", "required": ["id", "purpose", "trigger", "functionalBinding", "timing", "reducedMotion", "performanceBudget", "acceptance", "contractRef", "contractHash"], "properties": { "id": { "type": "string" }, "purpose": { "type": "string" }, "trigger": { "type": "string" }, "functionalBinding": { "type": "object", "required": ["task", "event", "stateTransition", "informationBenefit", "valueStatement"] }, "timing": { "type": "object" }, "reducedMotion": { "type": "string" }, "performanceBudget": { "type": "string" }, "acceptance": { "type": "array", "minItems": 1 }, "contractRef": { "type": "string", "minLength": 1 }, "contractHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } } } },
    "interaction": { "type": "array" },
    "responsive": { "$ref": "#/$defs/responsiveContract" },
    "visualSourceManifest": { "type": "object", "required": ["path", "hash"] },
    "implementationMap": { "type": "array", "minItems": 1 },
    "acceptance": { "type": "array", "minItems": 1 }
  },
  "$defs": {
    "responsiveContract": {
      "type": "object",
      "required": ["contractId", "viewports", "reflowRules", "overflowPolicy", "typographyScale", "mediaBehavior", "acceptance"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "viewports": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["class", "minWidth", "maxWidth", "layoutMode"], "properties": { "class": { "enum": ["mobile", "tablet", "desktop"] }, "minWidth": { "type": "integer", "minimum": 0 }, "maxWidth": { "type": "integer", "minimum": 0 }, "layoutMode": { "type": "string", "minLength": 1 } } } },
        "reflowRules": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
        "overflowPolicy": { "type": "object", "required": ["noUnintendedHorizontalOverflow", "exceptions"], "properties": { "noUnintendedHorizontalOverflow": { "const": true }, "exceptions": { "type": "array" } } },
        "typographyScale": { "type": "string", "minLength": 1 },
        "mediaBehavior": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
