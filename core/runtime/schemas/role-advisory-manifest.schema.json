{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APEX Role Advisory Manifest",
  "type": "object",
  "required": ["schemaVersion", "registry", "stages", "status"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "registry": { "type": "object", "required": ["path", "sha256", "upstreamCommit"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string" }, "upstreamCommit": { "type": "string" } }, "additionalProperties": false },
    "stages": { "type": "object", "additionalProperties": { "type": "object", "required": ["selectedRoles", "advisories", "summary", "summarySha256", "status"], "properties": { "selectedRoles": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "advisories": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["roleId", "path", "sha256", "operationReceipt"], "properties": { "roleId": { "type": "string" }, "path": { "type": "string" }, "sha256": { "type": "string" }, "operationReceipt": { "type": "string", "minLength": 1 } }, "additionalProperties": false } }, "summary": { "type": "string", "minLength": 1 }, "summarySha256": { "type": "string", "minLength": 8 }, "status": { "const": "ready" } }, "additionalProperties": false } },
    "status": { "const": "ready" }
  },
  "additionalProperties": false
}
