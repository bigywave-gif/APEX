{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://apex.local/schemas/industry-benchmark-review.schema.json","type":"object","required":["schemaVersion","assessmentMode","visualPlanHash","reviewer","observations","status"],"properties":{"schemaVersion":{"const":"1.0"},"assessmentMode":{"const":"evidence-bound-review"},"visualPlanHash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"reviewer":{"type":"object","required":["role","method"],"properties":{"role":{"enum":["apex-evaluator","design-reviewer"]},"method":{"const":"criterion-by-criterion runtime evidence review"}}},"observations":{"type":"array","minItems":1,"items":{"type":"object","required":["criterion","score","result","sourceSelectionIds","evidenceIds","finding"],"properties":{"criterion":{"type":"string","minLength":1},"score":{"type":"integer","minimum":0,"maximum":5},"result":{"enum":["passed","failed","unverified"]},"sourceSelectionIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"evidenceIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"finding":{"type":"string","minLength":12}}}},"status":{"const":"ready"}}}
