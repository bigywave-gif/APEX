{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://apex.local/schemas/runtime-source-lock.schema.json",
  "type":"object",
  "required":["schemaVersion","projectRoot","patterns"],
  "properties":{
    "schemaVersion":{"const":"3.0"},
    "projectRoot":{"type":"string","minLength":1},
    "runtimeRoot":{"type":"string","minLength":1},
    "sourceKind":{"enum":["project-installed","visual-sandbox"]},
    "patterns":{"type":"array","items":{"type":"object","required":["id","sourceSelectionId","visualNodes","package","version","componentPath","stylePaths","props","completeStyle","noCssPatch","files"],"properties":{
      "id":{"type":"string","minLength":1},
      "sourceSelectionId":{"type":"string","minLength":1},
      "visualNodes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
      "package":{"type":"string","minLength":1},
      "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
      "componentPath":{"type":"string","minLength":1},
      "stylePaths":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
      "animationPath":{"type":"string","minLength":1},
      "props":{"type":"object"},
      "completeStyle":{"const":true},
      "noCssPatch":{"const":true},
      "files":{"type":"array","minItems":1,"items":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}}}
    }}},
    "nativeSelections":{"type":"array","items":{"type":"object","required":["id","kind","sourceType","sourceId","resourceId","version","materialization","visualNodes","parameters"],"properties":{
      "id":{"type":"string","minLength":1},
      "kind":{"type":"string","minLength":1},
      "sourceType":{"type":"string","minLength":1},
      "sourceId":{"type":"string","minLength":1},
      "resourceId":{"type":"string","minLength":1},
      "version":{"type":"string","minLength":1},
      "materialization":{"type":"string","minLength":1},
      "visualNodes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
      "parameters":{"type":"object"}
    }}}
  },
  "anyOf":[
    {"properties":{"patterns":{"minItems":1}}},
    {"required":["nativeSelections"],"properties":{"nativeSelections":{"minItems":1}}}
  ]
}
