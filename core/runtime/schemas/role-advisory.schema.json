{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APEX Role Advisory",
  "type": "object",
  "required": ["schemaVersion", "roleId", "stage", "adapterVersion", "inputBindings", "findings", "recommendations", "status"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "roleId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["baseline", "gate1", "visual", "implementation", "verify"] },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "inputBindings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["artifact", "path", "sha256"], "properties": { "artifact": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "minLength": 8 } }, "additionalProperties": false } },
    "findings": { "type": "array", "items": { "type": "object", "required": ["id", "classification", "statement", "evidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "classification": { "enum": ["fact", "inference", "unverified"] }, "statement": { "type": "string", "minLength": 1 }, "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } },
    "recommendations": { "type": "array", "items": { "type": "object", "required": ["id", "choice", "rationale", "acceptance"], "properties": { "id": { "type": "string", "minLength": 1 }, "choice": { "type": "string", "minLength": 1 }, "rationale": { "type": "string", "minLength": 1 }, "alternatives": { "type": "array", "items": { "type": "string" } }, "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }, "additionalProperties": false } },
    "status": { "const": "ready" }
  },
  "additionalProperties": false
}
