{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/domain-model.schema.json",
  "type": "object",
  "required": ["schemaVersion", "entities", "rules", "states", "permissions"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "entities": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "fields"], "properties": { "name": { "type": "string" }, "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } } } } },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "permissions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
