{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/change-scope.schema.json",
  "type": "object",
  "required": ["schemaVersion", "mode", "requestedChanges", "affected", "protected", "impactAnalysis", "presentationPolicy", "status"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "mode": { "enum": ["localized", "page", "page-family", "sitewide"] },
    "requestedChanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "kind", "change", "reason"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["content", "data-display", "layout", "component", "style", "interaction", "motion", "accessibility", "responsive"] },
          "change": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "affected": { "$ref": "#/$defs/boundary" },
    "protected": {
      "type": "object",
      "required": ["policy", "routes", "pages", "visualNodes", "runtimeTargets", "files"],
      "properties": {
        "policy": { "const": "preserve-unless-explicitly-in-change-closure" },
        "routes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "pages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "visualNodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "runtimeTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "impactAnalysis": {
      "type": "object",
      "required": ["closureMethod", "crossCuttingChanges", "outOfScopeImpact"],
      "properties": {
        "closureMethod": { "const": "target-plus-transitive-runtime-dependencies" },
        "crossCuttingChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "justification"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "justification": { "type": "string", "minLength": 1 }
            }
          }
        },
        "outOfScopeImpact": { "const": "none" }
      }
    },
    "presentationPolicy": {
      "type": "object",
      "required": ["confirmationContent", "unchangedContent"],
      "properties": {
        "confirmationContent": { "const": "affected-closure-only" },
        "unchangedContent": { "const": "reference-baseline-without-republication" }
      }
    },
    "status": { "const": "frozen" }
  },
  "$defs": {
    "boundary": {
      "type": "object",
      "required": ["routes", "pages", "visualNodes", "dataViews", "runtimeTargets"],
      "properties": {
        "routes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "visualNodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "dataViews": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "runtimeTargets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
