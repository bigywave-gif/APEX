{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/runtime-visual-baseline.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceLockHash",
    "browserCapture",
    "referenceImage",
    "motionSamples"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "sourceLockHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "browserCapture": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "referenceImage": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "viewport"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "viewport": {
          "enum": [
            "desktop",
            "tablet",
            "mobile"
          ]
        }
      }
    },
    "motionSamples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "screenshot",
          "timestampMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "screenshot": {
            "type": "string",
            "minLength": 1
          },
          "timestampMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "screenCaptures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "viewport",
          "screenshot",
          "dom"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "viewport": {
            "type": "string",
            "pattern": "^[0-9]+x[0-9]+$"
          },
          "screenshot": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "dom": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "journeyCaptures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "task",
          "route",
          "url",
          "screenshot",
          "dom"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "navigation",
              "task",
              "role",
              "state",
              "reset"
            ]
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "screenshot": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "dom": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "finalUrl": {
            "type": "string",
            "minLength": 1
          },
          "viewport": {
            "type": "string",
            "pattern": "^[0-9]+x[0-9]+$"
          }
        }
      }
    }
  }
}
