{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/visual-reference.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "referenceImage",
    "contentLock",
    "layoutLock",
    "analyticsLock",
    "designTokens",
    "componentContracts"
    ],
    "existingCodeReference": {
      "type": "object",
      "required": ["sourceTreeHash", "sourceFileCount", "complete"],
      "properties": { "sourceTreeHash": { "type": "string", "minLength": 1 }, "sourceFileCount": { "type": "integer", "minimum": 1 }, "complete": { "const": true } }
    },
    "existingPageSkeleton": {
      "type": "object",
      "required": ["sourceTreeHash", "skeletonHash", "mappings"],
      "properties": { "sourceTreeHash": { "type": "string", "minLength": 1 }, "skeletonHash": { "type": "string", "minLength": 1 }, "mappings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["visualNode", "sourcePath", "sourceMarker"], "properties": { "visualNode": { "type": "string", "minLength": 1 }, "sourcePath": { "type": "string", "minLength": 1 }, "sourceMarker": { "type": "string", "minLength": 1 } } } } }
    },
  "properties": {
    "schemaVersion": {
      "const": "3.0"
    },
    "referenceImage": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "viewport"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "viewport": {
          "enum": [
            "desktop",
            "tablet",
            "mobile",
            "agnostic"
          ]
        }
      }
    },
    "contentLock": {
      "type": "object",
      "required": [
        "locale",
        "hash",
        "protectedText"
      ],
      "properties": {
        "locale": {
          "const": "zh-CN"
        },
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "protectedText": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protectedTableHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "layoutLock": {
      "type": "object",
      "required": [
        "mode",
        "hash",
        "protectedStructures",
        "nodes"
      ],
      "properties": {
        "mode": {
          "const": "strict"
        },
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "protectedStructures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "marker",
              "kind",
              "order"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "marker": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "analyticsLock": {
      "type": "object",
      "required": [
        "hash",
        "charts"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "charts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "metric",
              "dimension",
              "encoding",
              "marker"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "trend",
                  "progress",
                  "radar",
                  "distribution",
                  "bar",
                  "line",
                  "area",
                  "table"
                ]
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "encoding": {
                "type": "string",
                "minLength": 1
              },
              "marker": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "designTokens": {
      "type": "object"
    },
    "componentContracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "marker",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "marker": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "const": "gate1-visual"
    }
  }
}
