{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/context-sources.schema.json",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "stages", "invalidates"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "stages": { "type": "array", "minItems": 1 },
          "invalidates": { "type": "array" },
          "sensitive": { "type": "boolean" }
        }
      }
    }
  }
}
