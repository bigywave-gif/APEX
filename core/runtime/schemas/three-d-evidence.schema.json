{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/three-d-evidence.schema.json",
  "type": "object",
  "required": ["schemaVersion", "visualExecutionPlanHash", "scenes", "status"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "visualExecutionPlanHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "renderer", "assetSelectionIds", "screenshot", "performanceEvidence", "fallbackEvidence", "reducedMotionEvidence", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "renderer": { "enum": ["webgl", "webgpu"] },
          "assetSelectionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "screenshot": { "type": "string", "minLength": 1 },
          "performanceEvidence": { "type": "string", "minLength": 1 },
          "fallbackEvidence": { "type": "string", "minLength": 1 },
          "reducedMotionEvidence": { "type": "string", "minLength": 1 },
          "result": { "const": "passed" }
        }
      }
    },
    "status": { "const": "passed" }
  }
}
