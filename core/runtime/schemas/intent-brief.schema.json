{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/intent-brief.schema.json",
  "type": "object",
  "required": ["schemaVersion", "sourceRequest", "trackRecommendation", "goals", "successCriteria", "knownFacts", "assumptions", "openDecisions", "designIntent", "acceptance"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "sourceRequest": { "type": "string", "minLength": 1 },
    "trackRecommendation": { "enum": ["greenfield", "existing", "controlled-rebuild", "undetermined"] },
    "goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "successCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "knownFacts": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "object", "required": ["statement", "risk"], "properties": { "statement": { "type": "string" }, "risk": { "enum": ["low", "medium", "high"] } } } },
    "openDecisions": { "type": "array", "items": { "type": "string" } },
    "designIntent": { "type": "object", "required": ["formality", "visualIntensity", "motionIntensity", "informationDensity", "brandPosture"], "properties": { "formality": { "type": "string" }, "visualIntensity": { "type": "string" }, "motionIntensity": { "type": "string" }, "informationDensity": { "type": "string" }, "brandPosture": { "type": "string" } } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
