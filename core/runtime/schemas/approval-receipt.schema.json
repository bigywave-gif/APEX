{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/approval-receipt.schema.json",
  "title": "APEX Approval Receipt",
  "type": "object",
  "required": ["schemaVersion", "approvalId", "gate", "status", "projectId", "runId", "sessionId", "scope", "approvedAt", "artifactHashes"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "approvalId": { "type": "string", "minLength": 1 },
    "gate": { "enum": ["gate1", "visual-plan", "visual", "stitch", "implementation"] },
    "status": { "const": "approved" },
    "projectId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "approvedAt": { "type": "string", "minLength": 1 },
    "artifactHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
