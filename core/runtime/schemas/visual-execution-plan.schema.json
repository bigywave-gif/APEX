{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex.local/schemas/visual-execution-plan.schema.json",
  "type": "object",
  "required": ["schemaVersion", "deliveryNarrative", "layout", "visualSystem", "content", "components", "motion", "dependencies", "selectionAnalysis", "sourceSelections", "risks", "status"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "scopeControl": {
      "type": "object",
      "required": ["mode", "changeScopeHash", "affectedVisualNodes", "affectedRuntimeTargets", "protectedVisualNodes", "protectedRuntimeTargets", "presentationPolicy", "implementationPolicy", "tokenPolicy", "tokenDeltas", "unchangedSummary", "regressionPolicy"],
      "properties": {
        "mode": { "enum": ["localized", "page", "page-family", "sitewide"] },
        "changeScopeHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "affectedVisualNodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "affectedRuntimeTargets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "protectedVisualNodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "protectedRuntimeTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "presentationPolicy": { "const": "affected-closure-only" },
        "implementationPolicy": { "const": "deny-outside-change-closure" },
        "tokenPolicy": { "const": "inherit-existing-except-listed-deltas" },
        "tokenDeltas": { "type": "array" },
        "unchangedSummary": { "type": "string", "minLength": 1 },
        "regressionPolicy": { "const": "verify-protected-baseline-without-redesign" }
      }
    },
    "deliveryNarrative": { "type": "object", "required": ["mode"], "properties": { "mode": { "enum": ["greenfield-selection", "existing-iteration"] }, "selections": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["category", "sourceSelectionIds", "selectionBasis"], "properties": { "category": { "type": "string", "minLength": 1 }, "sourceSelectionIds": { "type": "array", "minItems": 1 }, "selectionBasis": { "type": "string", "minLength": 1 }, "expectedOutcome": { "type": "string", "minLength": 1 } } } }, "changes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["scope", "currentIssue", "change", "why", "sourceSelectionIds", "resolvedOutcome"], "properties": { "scope": { "type": "string", "minLength": 1 }, "currentIssue": { "type": "string", "minLength": 1 }, "change": { "type": "string", "minLength": 1 }, "why": { "type": "string", "minLength": 1 }, "sourceSelectionIds": { "type": "array", "minItems": 1 }, "resolvedOutcome": { "type": "string", "minLength": 1 } } } } } },
    "layout": { "type": "object", "required": ["informationArchitecture", "grid", "responsive"], "properties": { "responsive": { "$ref": "#/$defs/responsiveContract" } } },
    "visualSystem": { "type": "object", "required": ["styleDirection", "colors", "typography", "effects"], "properties": { "iconSystem": { "type": "object", "required": ["sourceSelectionId", "family", "variant", "sizeScale", "colorTokens"], "properties": { "sourceSelectionId": { "type": "string", "minLength": 1 }, "family": { "type": "string", "minLength": 1 }, "variant": { "type": "string", "minLength": 1 }, "sizeScale": { "type": "array", "minItems": 1 }, "strokeWidth": { "type": ["number", "string"] }, "colorTokens": { "type": "array", "minItems": 1 } } }, "chartSystem": { "type": "object", "required": ["sourceSelectionId", "themeSourceId", "themeId", "paletteTokens", "typographyToken", "axisAndGridTreatment", "tooltipTreatment", "composition"], "properties": { "sourceSelectionId": { "type": "string", "minLength": 1 }, "themeSourceId": { "type": "string", "minLength": 1 }, "themeId": { "type": "string", "minLength": 1 }, "paletteTokens": { "type": "array", "minItems": 1 }, "typographyToken": { "type": "string", "minLength": 1 }, "axisAndGridTreatment": { "type": "string", "minLength": 1 }, "tooltipTreatment": { "type": "string", "minLength": 1 }, "composition": { "type": "object", "required": ["layoutSourceSelectionId", "styleSourceSelectionId", "containerPattern", "hierarchy", "spacingTokens", "responsiveReflow", "emptyStateTreatment"], "properties": { "layoutSourceSelectionId": { "type": "string", "minLength": 1 }, "styleSourceSelectionId": { "type": "string", "minLength": 1 }, "containerPattern": { "type": "string", "minLength": 1 }, "hierarchy": { "type": "string", "minLength": 1 }, "spacingTokens": { "type": "array", "minItems": 1 }, "responsiveReflow": { "type": "array", "minItems": 2 }, "emptyStateTreatment": { "type": "string", "minLength": 1 } } } } } } },
    "content": { "type": "object", "required": ["hierarchy", "dataExpression", "states"] },
    "components": { "type": "array", "minItems": 1 },
    "motion": { "type": "array", "items": { "type": "object", "required": ["id", "purpose", "engine", "sourceId", "sourceSelectionId", "api", "reducedMotion"] } },
    "threeD": { "type": "array", "items": { "type": "object", "required": ["id", "engine", "renderer", "dependency", "assets", "performanceBudget", "fallback", "reducedMotion"], "properties": { "id": { "type": "string", "minLength": 1 }, "engine": { "enum": ["three-js", "babylon-js"] }, "renderer": { "enum": ["webgl", "webgpu"] }, "dependency": { "type": "object", "required": ["package", "version"], "properties": { "package": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } }, "assets": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["sourceSelectionId"], "properties": { "sourceSelectionId": { "type": "string", "minLength": 1 } } } }, "performanceBudget": { "type": "string", "minLength": 1 }, "fallback": { "type": "string", "minLength": 1 }, "reducedMotion": { "type": "string", "minLength": 1 } } } },
    "dependencies": { "type": "array", "items": { "type": "object", "required": ["package", "version", "status", "source", "installAfterGate2"], "properties": { "package": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "status": { "enum": ["installed", "planned", "not-required"] }, "source": { "type": "string", "minLength": 1 }, "installAfterGate2": { "type": "boolean" } } } },
    "selectionAnalysis": { "type": "object", "required": ["designCapabilities", "designContract", "aestheticAssessment", "libraryComparisons", "userNeedFit", "alternatives"], "properties": { "designCapabilities": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }, "designContract": { "type": "object", "required": ["path", "sha256", "rules"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "rules": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } } } }, "aestheticAssessment": { "type": "object", "required": ["coherenceChecks", "qualityRationale", "rejectedPatterns"], "properties": { "coherenceChecks": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } }, "qualityRationale": { "type": "string", "minLength": 1 }, "rejectedPatterns": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } } } }, "libraryComparisons": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["category", "candidates", "decisionRationale"], "properties": { "category": { "enum": ["layout", "style", "component", "icon", "chart", "motion", "font"] }, "candidates": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["sourceId", "resourceId", "version", "platformFit", "visualFit", "deliveryFit", "decision"], "properties": { "sourceId": { "type": "string", "minLength": 1 }, "resourceId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "platformFit": { "type": "string", "minLength": 1 }, "visualFit": { "type": "string", "minLength": 1 }, "deliveryFit": { "type": "string", "minLength": 1 }, "decision": { "enum": ["selected", "rejected"] } } } }, "decisionRationale": { "type": "string", "minLength": 1 } } } }, "userNeedFit": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["need", "selectedSourceIds", "rationale"], "properties": { "need": { "type": "string", "minLength": 1 }, "selectedSourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "rationale": { "type": "string", "minLength": 1 } } } }, "alternatives": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["candidate", "decision"], "properties": { "candidate": { "type": "string", "minLength": 1 }, "decision": { "type": "string", "minLength": 1 } } } } } },
    "sourceSelections": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["id", "visualNodes", "kind", "sourceType", "sourceId", "resourceId", "version", "materialization", "parameters"], "properties": { "id": { "type": "string", "minLength": 1 }, "visualNodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "kind": { "enum": ["layout", "component", "style", "icon", "font", "content", "motion", "asset", "chart", "diagram"] }, "sourceType": { "enum": ["existing-project", "approved-candidate", "native-web", "user-provided"] }, "sourceId": { "type": "string", "minLength": 1 }, "resourceId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "materialization": { "enum": ["existing-project", "inline-transfer", "generated-source", "runtime-package", "native-web"] }, "parameters": { "type": "object" } } } },
    "risks": { "type": "array" },
    "status": { "const": "ready-for-user-confirmation" }
  },
  "$defs": {
    "responsiveContract": {
      "type": "object",
      "required": ["contractId", "viewports", "reflowRules", "overflowPolicy", "typographyScale", "mediaBehavior", "acceptance"],
      "properties": {
        "contractId": { "type": "string", "minLength": 1 },
        "viewports": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["class", "minWidth", "maxWidth", "layoutMode"], "properties": { "class": { "enum": ["mobile", "tablet", "desktop"] }, "minWidth": { "type": "integer", "minimum": 0 }, "maxWidth": { "type": "integer", "minimum": 0 }, "layoutMode": { "type": "string", "minLength": 1 } } } },
        "reflowRules": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
        "overflowPolicy": { "type": "object", "required": ["noUnintendedHorizontalOverflow", "exceptions"], "properties": { "noUnintendedHorizontalOverflow": { "const": true }, "exceptions": { "type": "array" } } },
        "typographyScale": { "type": "string", "minLength": 1 },
        "mediaBehavior": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
